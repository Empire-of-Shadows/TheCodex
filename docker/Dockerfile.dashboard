## Stage 1: Clone repo and build frontend
FROM node:22-slim AS frontend

RUN apt-get update && \
    apt-get install -y --no-install-recommends git openssh-client && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Trust GitHub host key
RUN mkdir -p /root/.ssh && \
    ssh-keyscan github.com >> /root/.ssh/known_hosts

WORKDIR /repo
RUN --mount=type=ssh git clone git@github.com:Empire-of-Shadows/ImperialCodex.git .

WORKDIR /repo/dashboard/frontend
RUN npm ci && npm run build

## Stage 2: Python backend
FROM python:3.13-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    curl \
    openssh-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Trust GitHub host key
RUN mkdir -p /root/.ssh && \
    ssh-keyscan github.com >> /root/.ssh/known_hosts

# Clone the full repo (dashboard imports bot validators)
RUN --mount=type=ssh git clone git@github.com:Empire-of-Shadows/ImperialCodex.git .

# Install dashboard Python deps
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r dashboard/requirements.txt

# Copy built frontend from stage 1
COPY --from=frontend /repo/dashboard/frontend/dist /app/dashboard/frontend/dist/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8048

CMD ["python", "-m", "dashboard.app"]
